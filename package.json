{
  "name": "bugbounty-ide",
  "productName": "Bug Bounty IDE",
  "version": "1.0.0",
  "description": "Downloadable IDE for bug hunters — subdomain enum, Nuclei, scanning, exploitation. All tools run in-app.",
  "main": "main/main.js",
  "author": "Bug Bounty IDE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:static": "node scripts/vercel-build.js",
    "test:cli": "node src/cli.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.bugbounty.ide",
    "productName": "Bug Bounty IDE",
    "directories": { "output": "dist" },
    "files": [
      "main/**",
      "renderer/**",
      "tools-config/**",
      "src/**"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": { "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage"] }
  },
  "engines": { "node": ">=18" }
}
